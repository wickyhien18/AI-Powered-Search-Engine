# Search and LLM providers (required)
TAVILY_API_KEY=
GROQ_API_KEY=

# Optional: defaults are set in config.py
LLM_MODEL=openai/gpt-oss-20b
MIN_SCORE=0.20
CORS_ORIGINS=http://localhost:3000

# Rate limiting (Upstash Redis). Leave REDIS_URL empty to turn it off locally.
REDIS_URL=
RATE_LIMIT_IP_PER_MINUTE=5
RATE_LIMIT_IP_PER_DAY=10
RATE_LIMIT_GLOBAL_PER_DAY=30
RATE_LIMIT_FAIL_OPEN=false
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_DEBUG=false
